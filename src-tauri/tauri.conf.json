{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ночная чайная",
  "version": "1.2.0",
  "identifier": "com.ernomoon.chashi",
  "build": {
    "frontendDist": "../resources"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Ночная чайная",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "shadow": true,
        "resizable": true,
        "backgroundColor": "#03040e",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "publisher": "Ernomoon",
    "copyright": "© 2026 Ernomoon",
    "shortDescription": "Ночная чайная",
    "longDescription": "Таймер проливов для гунфу ча"
  }
}
